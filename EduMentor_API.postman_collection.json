{
  "info": {
    "name": "EduMentor AI API",
    "description": "Complete API collection for EduMentor AI - CSE471 Lab Project\n\n**Setup:**\n1. Set `baseUrl` = http://localhost:5001/api/v1\n2. For Notes endpoints: Set `clerkToken` (from browser after sign-in)\n3. Use {{noteId}} and {{conceptId}} after getting IDs from list responses",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001/api/v1"
    },
    {
      "key": "clerkToken",
      "value": ""
    },
    {
      "key": "noteId",
      "value": ""
    },
    {
      "key": "conceptId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/",
            "description": "Check if API server is running"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign Up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"yourPassword123\"\n}"
            },
            "url": "{{baseUrl}}/auth/signup",
            "description": "Create new user account"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"yourPassword123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Login and get access token"
          }
        }
      ]
    },
    {
      "name": "AI",
      "item": [
        {
          "name": "Ask Question",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"What is photosynthesis?\",\n  \"difficulty\": \"beginner\",\n  \"conversationHistory\": []\n}"
            },
            "url": "{{baseUrl}}/ai/ask",
            "description": "Feature 1 - Adaptive AI Question Answering. Difficulty: beginner | intermediate | advanced"
          }
        },
        {
          "name": "Ask Question (Follow-up)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"Can you give an example?\",\n  \"difficulty\": \"intermediate\",\n  \"conversationHistory\": [\n    { \"role\": \"user\", \"content\": \"What is recursion?\" },\n    { \"role\": \"assistant\", \"content\": \"Recursion is when a function calls itself...\" }\n  ]\n}"
            },
            "url": "{{baseUrl}}/ai/ask",
            "description": "Ask follow-up with conversation history"
          }
        },
        {
          "name": "Analyze Code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"function add(a, b) { return a + b }\",\n  \"language\": \"javascript\",\n  \"difficulty\": \"intermediate\"\n}"
            },
            "url": "{{baseUrl}}/ai/analyze-code",
            "description": "Feature 3 - AI Code Mentor. Get debugging, explanation, optimization"
          }
        }
      ]
    },
    {
      "name": "Concepts",
      "item": [
        {
          "name": "Get History",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/concepts/history",
            "description": "Get last 20 AI-generated concepts"
          }
        },
        {
          "name": "Get Concept by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/concepts/{{conceptId}}",
            "description": "Get single concept. Set conceptId from history response"
          }
        },
        {
          "name": "Update Concept (userNote)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userNote\": \"My personal revision note for exam\"\n}"
            },
            "url": "{{baseUrl}}/concepts/{{conceptId}}",
            "description": "Add or update personal note on concept"
          }
        },
        {
          "name": "Delete Concept",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/concepts/{{conceptId}}",
            "description": "Delete a concept by ID"
          }
        }
      ]
    },
    {
      "name": "Notes",
      "item": [
        {
          "name": "Upload PDF",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{clerkToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "pdf",
                  "type": "file",
                  "src": "",
                  "description": "Select PDF file"
                }
              ]
            },
            "url": "{{baseUrl}}/notes/upload",
            "description": "Feature 5 - Upload PDF, get AI summary (RAG). Requires Clerk auth"
          }
        },
        {
          "name": "Get All Notes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{clerkToken}}"
              }
            ],
            "url": "{{baseUrl}}/notes",
            "description": "Get all notes for logged-in user"
          }
        },
        {
          "name": "Get Note by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{clerkToken}}"
              }
            ],
            "url": "{{baseUrl}}/notes/{{noteId}}",
            "description": "Get single note. Set noteId from list response"
          }
        },
        {
          "name": "Update Note (rename)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{clerkToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"My Updated Note Title\"\n}"
            },
            "url": "{{baseUrl}}/notes/{{noteId}}",
            "description": "Update note title"
          }
        },
        {
          "name": "Delete Note",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{clerkToken}}"
              }
            ],
            "url": "{{baseUrl}}/notes/{{noteId}}",
            "description": "Delete a note by ID"
          }
        },
        {
          "name": "Ask from Note (Document Q&A)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{clerkToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"What are the key takeaways from this document?\"\n}"
            },
            "url": "{{baseUrl}}/notes/{{noteId}}/ask",
            "description": "Feature 6 - Ask question from uploaded document content"
          }
        }
      ]
    }
  ]
}